# Copy to .env and fill in real values for local dev.
# In Railway, these are set via the service's Variables tab.

# Postgres — Railway internal hostname when deployed; localhost or pgvector public URL when local
DATABASE_URL=postgresql://assistant:PASSWORD@pgvector.railway.internal:5432/assistant

# Anthropic API key (sk-ant-...)
ANTHROPIC_API_KEY=

# Telegram bot — same token n8n uses
TELEGRAM_BOT_TOKEN=

# The single Phase 1 user. Phase 5+: derive from request, not env.
USER_ID=591ebda6-7476-4dc6-8296-687eb4e13c57
TELEGRAM_CHAT_ID=8572693842

# Shared secret between n8n and this service.
# n8n adds X-Internal-Auth header on every webhook forward.
# Generate with: openssl rand -base64 32
INTERNAL_AUTH_TOKEN=

# Server port (Railway sets PORT automatically; default 8080 locally)
PORT=8080

# 'production' silences debug logs and disables /debug routes
NODE_ENV=development
